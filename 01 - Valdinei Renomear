Function CriarBotao( _
    ByVal texto As String, _
    ByVal x As Integer, _
    ByVal y As Integer, _
    ByVal largura As Integer) As System.Windows.Forms.Button

    Dim b As New System.Windows.Forms.Button

    b.Text = texto
    b.SetBounds(x, y, largura, 32)
    b.BackColor = CorBotao()
    b.ForeColor = CorTexto()
    b.FlatStyle = System.Windows.Forms.FlatStyle.Flat
    b.FlatAppearance.BorderColor = CorBorda()
    b.FlatAppearance.BorderSize = 1
    b.Font = New System.Drawing.Font("Segoe UI", 9.0!)
    b.UseVisualStyleBackColor = False

    Return b

End Function


