End Function


Sub AtualizarProgressoDOMA( _
    ByVal f As System.Windows.Forms.Form, _
    ByVal valor As Integer, _
    ByVal textoEtapa As String, _
    ByVal textoArquivo As String, _
    ByVal textoContador As String)

    If f Is Nothing OrElse f.IsDisposed Then Return

    Dim percentual As Integer = System.Math.Max(0, System.Math.Min(100, valor))

    DirectCast(f.Controls("barraProgressoDOMA"), _
        System.Windows.Forms.ProgressBar).Value = percentual

    DirectCast(f.Controls("percentualProgressoDOMA"), _
        System.Windows.Forms.Label).Text = percentual.ToString() & "%"

    DirectCast(f.Controls("etapaProgressoDOMA"), _
        System.Windows.Forms.Label).Text = textoEtapa

    DirectCast(f.Controls("arquivoProgressoDOMA"), _
        System.Windows.Forms.Label).Text = textoArquivo

    DirectCast(f.Controls("contadorProgressoDOMA"), _
        System.Windows.Forms.Label).Text = textoContador

    System.Windows.Forms.Application.DoEvents()

End Sub


Sub FecharProgressoDOMA(ByRef f As System.Windows.Forms.Form)

    If f Is Nothing Then Return

    Try
        f.TopMost = False
        f.Close()
        f.Dispose()
    Catch
    End Try

    f = Nothing

End Sub


Sub LerLogProgressoDOMA( _
    ByVal caminhoLog As String, _
    ByVal f As System.Windows.Forms.Form, _
    ByRef indiceLinha As Integer, _
    ByRef processados As Integer, _
    ByRef total As Integer)

    If Not System.IO.File.Exists(caminhoLog) Then Return

    Try

        Dim linhasLog() As String
        linhasLog = System.IO.File.ReadAllLines(caminhoLog)

        While indiceLinha < linhasLog.Length

            Dim linhaAtual As String = linhasLog(indiceLinha)
            Dim campos() As String = linhaAtual.Split("|"c)

            If campos.Length >= 2 Then

                If campos(0) = "APPRENTICE" Then

                    AtualizarProgressoDOMA( _
                        f, 55, _
                        "Apprentice iniciado.", _
                        "Mecanismo de processamento de desenhos inicializado.", _
                        "IDWs na fila: " & total.ToString())

                ElseIf campos(0) = "ATUAL" Then

                    Dim nomeAtual As String = campos(1)

                    Try
                        nomeAtual = System.IO.Path.GetFileName(nomeAtual)
                    Catch
                    End Try

                    Dim percentualAtual As Integer = 55

                    If total > 0 Then
                        percentualAtual = 55 + CInt((processados / CDbl(total)) * 35)
                    End If

                    AtualizarProgressoDOMA( _
                        f, percentualAtual, _
                        "Processando referências dos desenhos...", _
                        "Em processamento: " & nomeAtual, _
                        "Arquivos processados: " & processados.ToString() & _
                        " de " & total.ToString())

                ElseIf campos(0) = "PROGRESS" AndAlso campos.Length >= 4 Then

                    Dim valorProcessados As Integer
                    Dim valorTotal As Integer

                    If Integer.TryParse(campos(1), valorProcessados) Then
                        processados = valorProcessados
                    End If

                    If Integer.TryParse(campos(2), valorTotal) Then
                        total = valorTotal
                    End If

                    Dim nomeConcluido As String = campos(3)

                    Try
                        nomeConcluido = System.IO.Path.GetFileName(nomeConcluido)
                    Catch
                    End Try

                    Dim percentualConcluido As Integer = 90

                    If total > 0 Then
                        percentualConcluido = 55 + CInt((processados / CDbl(total)) * 35)
                    End If

                    AtualizarProgressoDOMA( _
                        f, percentualConcluido, _
                        "Processando referências dos desenhos...", _
                        "Último arquivo processado: " & nomeConcluido, _
                        "Arquivos processados: " & processados.ToString() & _
                        " de " & total.ToString())

                End If

            End If

            indiceLinha += 1

        End While

    Catch
        ' O log pode estar sendo gravado pelo PowerShell neste instante.
        ' A leitura será repetida na próxima passagem do monitoramento.
    End Try

End Sub


' ============================================================
' PROCESSAMENTO DA RENOMEAÇÃO
' LÓGICA ORIGINAL PRESERVADA
' ============================================================

Function ProcessarRenomeacao( _
    ByVal oMontagem As AssemblyDocument, _
    ByVal oOcorrencia As ComponentOccurrence) As Integer

    ' Retorno:
    '  1 = renomeação concluída
    '  0 = operação cancelada pelo usuário
    ' -1 = operação com falha

    Dim oIDWsAbertosPelaRegra As New System.Collections.ArrayList
    Dim oJanelaProgresso As System.Windows.Forms.Form = Nothing

    Try

        Dim oDocumento As Document
        oDocumento = oOcorrencia.Definition.Document

        If oDocumento.DocumentType <> _
            DocumentTypeEnum.kPartDocumentObject AndAlso _
           oDocumento.DocumentType <> _
            DocumentTypeEnum.kAssemblyDocumentObject Then

            MensagemVisual( _
                "Selecione uma peça ou submontagem válida.", _
                "Renomear componente")
            Return -1

        End If

        Dim oArquivo As String
        oArquivo = oDocumento.FullFileName

        Dim oCaminhoProtecao As String
        oCaminhoProtecao = "\" & oArquivo.Replace("/", "\").ToUpperInvariant() & "\"

        If oCaminhoProtecao.Contains("\OLDVERSIONS\") OrElse _
           oCaminhoProtecao.Contains("\CENTRO DE CONTEUDO INVENTOR\") OrElse _
           oCaminhoProtecao.Contains("\CONTENT CENTER FILES\") OrElse _
           oCaminhoProtecao.Contains("\DESIGN ACCELERATOR\") Then

            MensagemVisual( _
                "Este arquivo está em uma pasta protegida." & _
                vbCrLf & vbCrLf & oArquivo & vbCrLf & vbCrLf & _
                "Nenhuma alteração foi realizada.", _
                "Renomeação bloqueada", _
                System.Windows.Forms.MessageBoxButtons.OK, _
                System.Windows.Forms.MessageBoxIcon.Warning)
            Return -1

        End If

        If String.IsNullOrWhiteSpace(oArquivo) OrElse _
           Not System.IO.File.Exists(oArquivo) Then

            MensagemVisual( _
                "O arquivo original não foi encontrado:" & vbCrLf & oArquivo, _
                "Renomear componente")

            Return -1

        End If

        Dim oPasta As String
        Dim oExtensao As String
        Dim oNomeAtual As String

        oPasta = System.IO.Path.GetDirectoryName(oArquivo)
        oExtensao = System.IO.Path.GetExtension(oArquivo)
        oNomeAtual = System.IO.Path.GetFileNameWithoutExtension(oArquivo)

        Dim oNovoNome As String
        oNovoNome = EntradaVisual( _
            "Nome atual: " & oNomeAtual & vbCrLf & vbCrLf & _
            "Digite o novo nome, sem a extensão:", _
            "Renomear componente", oNomeAtual)

        If String.IsNullOrWhiteSpace(oNovoNome) Then Return 0

        oNovoNome = oNovoNome.Trim()

        If oNovoNome.IndexOfAny( _
            System.IO.Path.GetInvalidFileNameChars()) >= 0 OrElse _
           oNovoNome.EndsWith(".") OrElse _
           oNovoNome.EndsWith(" ") Then

            MensagemVisual( _
                "O nome contém caracteres inválidos.", _
                "Renomear componente")
            Return -1

        End If

        If String.Equals(oNovoNome, oNomeAtual, _
            StringComparison.OrdinalIgnoreCase) Then Return 0

        Dim oNovoArquivo As String
        oNovoArquivo = System.IO.Path.Combine( _
            oPasta, oNovoNome & oExtensao)

        If System.IO.File.Exists(oNovoArquivo) Then

            MensagemVisual( _
                "Já existe um arquivo com esse nome:" & _
                vbCrLf & oNovoArquivo, _
                "Renomear componente")

            Return -1

        End If

        If MensagemVisual( _
            "Arquivo atual:" & vbCrLf & oArquivo & _
            vbCrLf & vbCrLf & _
            "Novo arquivo:" & vbCrLf & oNovoArquivo & _
            vbCrLf & vbCrLf & _
            "Antes de continuar, certifique-se de que existe uma cópia de segurança do projeto." & _
            vbCrLf & vbCrLf & _
            "Os desenhos IDW do Workspace e suas subpastas serão verificados, exceto OldVersions." & _
            vbCrLf & vbCrLf & _
            "Deseja continuar?", _
            "Confirmar renomeação", _
            System.Windows.Forms.MessageBoxButtons.YesNo, _
            System.Windows.Forms.MessageBoxIcon.Warning) <> _
            System.Windows.Forms.DialogResult.Yes Then Return 0

        Dim oPastaRaiz As String = ""

        Try
            oPastaRaiz = ThisApplication.DesignProjectManager. _
                ActiveDesignProject.WorkspacePath
        Catch
            oPastaRaiz = ""
        End Try

        If String.IsNullOrWhiteSpace(oPastaRaiz) OrElse _
           Not System.IO.Directory.Exists(oPastaRaiz) Then

            MensagemVisual( _
                "Não foi possível identificar a pasta de trabalho do projeto ativo." & _
                vbCrLf & vbCrLf & "A renomeação foi cancelada.", _
                "Renomear componente")
            Return -1

        End If

        Dim oRaizNormalizada As String
        Dim oArquivoNormalizado As String

        oRaizNormalizada = System.IO.Path.GetFullPath(oPastaRaiz).TrimEnd( _
            System.IO.Path.DirectorySeparatorChar, _
            System.IO.Path.AltDirectorySeparatorChar) & _
            System.IO.Path.DirectorySeparatorChar

        oArquivoNormalizado = System.IO.Path.GetFullPath(oArquivo)

        If Not oArquivoNormalizado.StartsWith( _
            oRaizNormalizada, StringComparison.OrdinalIgnoreCase) Then

            MensagemVisual( _
                "O arquivo selecionado não pertence à pasta de trabalho do projeto ativo." & _
                vbCrLf & vbCrLf & "A renomeação foi cancelada.", _
                "Renomear componente")
            Return -1

        End If

        oJanelaProgresso = CriarJanelaProgressoDOMA()
        AtualizarProgressoDOMA( _
            oJanelaProgresso, 5, _
            "Verificando documentos abertos...", _
            "Conferindo os desenhos atualmente abertos no Inventor.", _
            "Verificação inicial")

        ' ============================================================
        ' VERIFICA SOMENTE OS IDWS ABERTOS DENTRO DO WORKSPACE
        ' Desenhos externos ao Workspace são ignorados completamente.
        ' Se um IDW interno aberto referenciar o componente, interrompe.
        ' Se a leitura de um IDW interno falhar, interrompe por segurança.
        ' ============================================================

        Dim oIDWsAbertosNoInventor As New System.Collections.ArrayList
        Dim oIDWsComReferenciaAberta As New System.Collections.ArrayList

        Dim oDocumentoAberto As Document
        Dim oDescritorAberto As Object
        Dim oCaminhoReferenciaAberta As String
        Dim oCaminhoIDWAberto As String
        Dim oCaminhoIDWAbertoNormalizado As String
        Dim oErroVerificacaoAberta As String = ""
        Dim oNomeIDWAberto As String
        Dim oDocumentosVerificados As Integer = 0
        Dim oTotalDocumentosAbertos As Integer = ThisApplication.Documents.Count
        If oTotalDocumentosAbertos < 1 Then oTotalDocumentosAbertos = 1

        For Each oDocumentoAberto In ThisApplication.Documents

            oDocumentosVerificados += 1
            Dim oPercentualAbertos As Integer = 5 + CInt( _
                (oDocumentosVerificados / CDbl(oTotalDocumentosAbertos)) * 7)
            AtualizarProgressoDOMA( _
                oJanelaProgresso, oPercentualAbertos, _
                "Verificando documentos abertos...", _
                "Analisando documentos carregados no Inventor.", _
                "Documentos verificados: " & oDocumentosVerificados.ToString() & _
                " de " & oTotalDocumentosAbertos.ToString())

            If oDocumentoAberto.DocumentType = _
                DocumentTypeEnum.kDrawingDocumentObject Then

                oCaminhoIDWAberto = ""
                oCaminhoIDWAbertoNormalizado = ""
                oNomeIDWAberto = "Desenho aberto sem nome de arquivo"

                Try
                    oCaminhoIDWAberto = oDocumentoAberto.FullFileName

                    If Not String.IsNullOrWhiteSpace(oCaminhoIDWAberto) Then

                        oCaminhoIDWAbertoNormalizado = _
                            System.IO.Path.GetFullPath(oCaminhoIDWAberto)
                        oNomeIDWAberto = oCaminhoIDWAbertoNormalizado

                        ' Somente desenhos dentro do Workspace entram
                        ' na proteção e na lista de exclusão do processamento.
                        If oCaminhoIDWAbertoNormalizado.StartsWith( _
                            oRaizNormalizada, _
                            StringComparison.OrdinalIgnoreCase) Then

                            If Not oIDWsAbertosNoInventor.Contains( _
                                oCaminhoIDWAbertoNormalizado) Then
                                oIDWsAbertosNoInventor.Add( _
                                    oCaminhoIDWAbertoNormalizado)
                            End If

                            For Each oDescritorAberto In _
                                oDocumentoAberto.ReferencedDocumentDescriptors

                                oCaminhoReferenciaAberta = _
                                    oDescritorAberto.FullDocumentName

                                If Not String.IsNullOrWhiteSpace( _
                                    oCaminhoReferenciaAberta) Then

                                    oCaminhoReferenciaAberta = _
                                        System.IO.Path.GetFullPath( _
                                            oCaminhoReferenciaAberta)

                                    If String.Equals( _
                                        oCaminhoReferenciaAberta, _
                                        oArquivoNormalizado, _
                                        StringComparison.OrdinalIgnoreCase) Then

                                        If Not oIDWsComReferenciaAberta.Contains( _
                                            oNomeIDWAberto) Then
                                            oIDWsComReferenciaAberta.Add( _
                                                oNomeIDWAberto)
                                        End If

                                    End If

                                End If

                            Next

                        End If

                    End If

                Catch ex As Exception

                    ' Um erro só bloqueia quando já foi identificado que
                    ' o desenho está dentro do Workspace.
                    If Not String.IsNullOrWhiteSpace( _
                        oCaminhoIDWAbertoNormalizado) AndAlso _
                       oCaminhoIDWAbertoNormalizado.StartsWith( _
                            oRaizNormalizada, _
                            StringComparison.OrdinalIgnoreCase) Then

                        oErroVerificacaoAberta = _
                            oNomeIDWAberto & vbCrLf & ex.Message
                        Exit For

                    End If

                End Try

            End If

        Next

        If Not String.IsNullOrWhiteSpace(oErroVerificacaoAberta) Then

            FecharProgressoDOMA(oJanelaProgresso)

            MensagemVisual( _
                "Não foi possível verificar um desenho aberto dentro do Workspace:" & _
                vbCrLf & vbCrLf & oErroVerificacaoAberta & _
                vbCrLf & vbCrLf & _
                "Nenhuma renomeação foi realizada.", _
                "Renomeação bloqueada", _
                System.Windows.Forms.MessageBoxButtons.OK, _
                System.Windows.Forms.MessageBoxIcon.Warning)

            Return -1

        End If


Dim oPastaIDW As String

' A busca dos desenhos será realizada a partir
' da raiz do Workspace do projeto ativo.
oPastaIDW = oPastaRaiz

If Not System.IO.Directory.Exists(oPastaIDW) Then

    FecharProgressoDOMA(oJanelaProgresso)

    MensagemVisual( _
        "A pasta Workspace do projeto não foi encontrada:" & _
        vbCrLf & oPastaIDW & vbCrLf & vbCrLf & _
        "A renomeação foi cancelada.", _
        "Renomear componente")
    Return -1

End If


        Dim oArquivoIDWs() As String
        Dim oListaIDWs As New System.Collections.ArrayList
        Dim oPastasPendentes As New System.Collections.Stack
        Dim oPastaPesquisa As String
        Dim oSubpastas As String()
        Dim oArquivosEncontrados As String()
        Dim oSubpasta As String
        Dim oNomePasta As String
        Dim oIDWEstaAbertoNoInventor As Boolean
        Dim oCaminhoAbertoComparacao As String
        Dim oArquivoIDW As String

        oPastasPendentes.Push(oPastaIDW)
        Dim oPastasVerificadas As Integer = 0

        AtualizarProgressoDOMA( _
            oJanelaProgresso, 15, _
            "Localizando desenhos do projeto...", _
            "Percorrendo o Workspace e suas subpastas, exceto OldVersions.", _
            "Iniciando busca de arquivos IDW...")

        While oPastasPendentes.Count > 0

            oPastaPesquisa = CStr(oPastasPendentes.Pop())
            oPastasVerificadas += 1
            AtualizarProgressoDOMA( _
                oJanelaProgresso, 15, _
                "Localizando desenhos do projeto...", _
                System.IO.Path.GetFileName(oPastaPesquisa), _
                "Pastas verificadas: " & oPastasVerificadas.ToString())

            Try
                oArquivosEncontrados = System.IO.Directory.GetFiles( _
                    oPastaPesquisa, "*.idw", _
                    System.IO.SearchOption.TopDirectoryOnly)

                For Each oArquivoEncontrado As String In oArquivosEncontrados
                    oListaIDWs.Add(oArquivoEncontrado)
                Next
            Catch
            End Try

            Try
                oSubpastas = System.IO.Directory.GetDirectories(oPastaPesquisa)

                For Each oSubpasta In oSubpastas

                    oNomePasta = System.IO.Path.GetFileName( _
                        oSubpasta.TrimEnd( _
                            System.IO.Path.DirectorySeparatorChar, _
                            System.IO.Path.AltDirectorySeparatorChar))

                    If Not String.Equals( _
                        oNomePasta, "OldVersions", _
                        StringComparison.OrdinalIgnoreCase) Then

                        oPastasPendentes.Push(oSubpasta)

                    End If

                Next
            Catch
            End Try

        End While

        oArquivoIDWs = DirectCast( _
            oListaIDWs.ToArray(GetType(String)), String())

        AtualizarProgressoDOMA( _
            oJanelaProgresso, 25, _
            "Busca de desenhos concluída.", _
            "Arquivos IDW localizados no Workspace.", _
            "IDWs localizados: " & oArquivoIDWs.Length.ToString())

        If oArquivoIDWs.Length = 0 Then

            FecharProgressoDOMA(oJanelaProgresso)

            MensagemVisual( _
                "Nenhum desenho IDW foi encontrado no Workspace do projeto ativo.", _
                "Renomear componente", _
                System.Windows.Forms.MessageBoxButtons.OK, _
                System.Windows.Forms.MessageBoxIcon.Warning)

            Return -1

        End If

        ' ============================================================
        ' PREPARA A LISTA PARA O APPRENTICE
        ' Somente IDWs fechados, dentro do Workspace e fora de OldVersions.
        ' IDWs abertos pelo usuário já foram verificados acima e não entram.
        ' ============================================================

        Dim oIDWsParaApprentice As New System.Collections.ArrayList

        For Each oArquivoIDW In oArquivoIDWs

            oIDWEstaAbertoNoInventor = False

            For Each oCaminhoAbertoComparacao In oIDWsAbertosNoInventor

                If String.Equals( _
                    System.IO.Path.GetFullPath(oArquivoIDW), _
                    CStr(oCaminhoAbertoComparacao), _
                    StringComparison.OrdinalIgnoreCase) Then

                    oIDWEstaAbertoNoInventor = True
                    Exit For

                End If

            Next

            If Not oIDWEstaAbertoNoInventor Then
                oIDWsParaApprentice.Add(oArquivoIDW)
            End If

        Next

        AtualizarProgressoDOMA( _
            oJanelaProgresso, 32, _
            "Preparando desenhos para atualização...", _
            "Separando os IDWs fechados que serão verificados pelo Apprentice.", _
            "IDWs destinados ao Apprentice: " & oIDWsParaApprentice.Count.ToString())

        AtualizarProgressoDOMA( _
            oJanelaProgresso, 36, _
            "Renomeando componente...", _
            "Atualizando o Part Number e o arquivo do componente.", _
            "Etapa de renomeação")

        Dim oPropriedade As Object
        oPropriedade = oDocumento.PropertySets. _
            Item("Design Tracking Properties").Item("Part Number")
        oPropriedade.Value = oNovoNome
        oDocumento.Save()

        ThisApplication.FileManager.MoveFile(oArquivo, oNovoArquivo)

        Dim oOriginalExiste As Boolean
        Dim oDestinoExiste As Boolean

        oOriginalExiste = System.IO.File.Exists(oArquivo)
        oDestinoExiste = System.IO.File.Exists(oNovoArquivo)

        If oOriginalExiste OrElse Not oDestinoExiste Then

            FecharProgressoDOMA(oJanelaProgresso)

            MensagemVisual( _
                "Não foi possível confirmar a renomeação." & _
                vbCrLf & vbCrLf & _
                "Verifique os arquivos antes de continuar.", _
                "Renomear componente")

            Return -1

        End If

        oOcorrencia.ReferencedDocumentDescriptor. _
            ReferencedFileDescriptor.ReplaceReference(oNovoArquivo)

        AtualizarProgressoDOMA( _
            oJanelaProgresso, 45, _
            "Atualizando referências...", _
            "Referência da ocorrência substituída na montagem ativa.", _
            "Componente renomeado")
			
' ============================================================
' ATUALIZA REFERENCIAS DOS IDWS ABERTOS NO INVENTOR
' Não salva os desenhos. O usuário fará o salvamento manual.
' ============================================================

Dim oIDWDocumentoAberto As Document
Dim oIDWDescritor As Object
Dim oDescritorAtualizar As Object

Dim oIDWCaminho As String
Dim oIDWCaminhoNormalizado As String
Dim oIDWCaminhoReferencia As String

Dim oIDWEncontrado As Boolean
Dim oNovaReferenciaConfirmada As Boolean
Dim oReferenciaAntigaPermaneceu As Boolean

Dim oDescritoresParaAtualizar As System.Collections.ArrayList

Dim oIDWFalhasAbertos As New System.Collections.ArrayList
Dim oIDWAtualizados As Integer = 0
Dim oDocumentosAbertosVerificados As Integer = 0
Dim oTotalDocumentosAbertos2 As Integer = ThisApplication.Documents.Count
If oTotalDocumentosAbertos2 < 1 Then oTotalDocumentosAbertos2 = 1

For Each oIDWDocumentoAberto In ThisApplication.Documents

    oDocumentosAbertosVerificados += 1
    Dim oPercentualAbertos2 As Integer = 45 + CInt( _
        (oDocumentosAbertosVerificados / CDbl(oTotalDocumentosAbertos2)) * 5)
    AtualizarProgressoDOMA( _
        oJanelaProgresso, oPercentualAbertos2, _
        "Conferindo desenhos abertos...", _
        "Verificando e substituindo referências nos documentos carregados.", _
        "Documentos conferidos: " & oDocumentosAbertosVerificados.ToString() & _
        " de " & oTotalDocumentosAbertos2.ToString())

    If oIDWDocumentoAberto.DocumentType = _
        DocumentTypeEnum.kDrawingDocumentObject Then

        oIDWCaminho = ""

        Try
            oIDWCaminho = oIDWDocumentoAberto.FullFileName

            If Not String.IsNullOrWhiteSpace(oIDWCaminho) Then

                oIDWCaminhoNormalizado = _
                    System.IO.Path.GetFullPath(oIDWCaminho)

                If oIDWCaminhoNormalizado.StartsWith( _
                    oRaizNormalizada, _
                    StringComparison.OrdinalIgnoreCase) Then

                    oIDWEncontrado = False

                    oDescritoresParaAtualizar = _
                        New System.Collections.ArrayList

                    ' Localiza e guarda as referências antigas.
                    For Each oIDWDescritor In _
                        oIDWDocumentoAberto.ReferencedDocumentDescriptors

                        oIDWCaminhoReferencia = _
                            oIDWDescritor.FullDocumentName

                        If Not String.IsNullOrWhiteSpace( _
                            oIDWCaminhoReferencia) Then

                            oIDWCaminhoReferencia = _
                                System.IO.Path.GetFullPath( _
                                    oIDWCaminhoReferencia)

                            If String.Equals( _
                                oIDWCaminhoReferencia, _
                                oArquivoNormalizado, _
                                StringComparison.OrdinalIgnoreCase) Then

                                oDescritoresParaAtualizar.Add( _
                                    oIDWDescritor.ReferencedFileDescriptor)

                                oIDWEncontrado = True

                            End If

                        End If

                    Next

                    ' Substitui as referências localizadas.
                    If oIDWEncontrado Then

                        For Each oDescritorAtualizar In _
                            oDescritoresParaAtualizar

                            oDescritorAtualizar.ReplaceReference( _
                                oNovoArquivo)

                        Next

                        ' Confirma a nova referência e a ausência da antiga.
                        oNovaReferenciaConfirmada = False
                        oReferenciaAntigaPermaneceu = False

                        For Each oIDWDescritor In _
                            oIDWDocumentoAberto.ReferencedDocumentDescriptors

                            oIDWCaminhoReferencia = _
                                oIDWDescritor.FullDocumentName

                            If Not String.IsNullOrWhiteSpace( _
                                oIDWCaminhoReferencia) Then

                                oIDWCaminhoReferencia = _
                                    System.IO.Path.GetFullPath( _
                                        oIDWCaminhoReferencia)

                                If String.Equals( _
                                    oIDWCaminhoReferencia, _
                                    System.IO.Path.GetFullPath(oNovoArquivo), _
                                    StringComparison.OrdinalIgnoreCase) Then

                                    oNovaReferenciaConfirmada = True

                                End If

                                If String.Equals( _
                                    oIDWCaminhoReferencia, _
                                    oArquivoNormalizado, _
                                    StringComparison.OrdinalIgnoreCase) Then

                                    oReferenciaAntigaPermaneceu = True

                                End If

                            End If

                        Next

                        If Not oNovaReferenciaConfirmada Then
                            Throw New Exception( _
                                "A nova referência não foi confirmada no desenho.")
                        End If

                        If oReferenciaAntigaPermaneceu Then
                            Throw New Exception( _
                                "A referência antiga permaneceu no desenho.")
                        End If

                        oIDWAtualizados += 1

                    End If

                End If

            End If

        Catch ex As Exception

            oIDWFalhasAbertos.Add( _
                oIDWCaminho & vbCrLf & ex.Message)

        End Try

    End If

Next


' ============================================================
' CONTROLE DE FALHAS DOS IDWS ABERTOS
' ============================================================

Dim oFalhasDesenho As Integer = 0

If oIDWFalhasAbertos.Count > 0 Then
    oFalhasDesenho = 1
End If

Dim oListaFalhasIDWsAbertos As String = ""

If oIDWFalhasAbertos.Count > 0 Then

    For Each oFalhaIDWAberto As String In oIDWFalhasAbertos

        oListaFalhasIDWsAbertos &= _
            oFalhaIDWAberto & vbCrLf & vbCrLf

    Next

End If


' ============================================================
' PREPARAÇÃO DOS ARQUIVOS DO APPRENTICE
' ============================================================

AtualizarProgressoDOMA( _
    oJanelaProgresso, 50, _
    "Preparando processamento dos IDWs...", _
    "Criando os arquivos temporários de entrada, script e registro.", _
    "IDWs fechados: " & oIDWsParaApprentice.Count.ToString())

Dim oResultadoApprentice As String = ""
Dim oPastaTemporaria As String
Dim oArquivoEntradaApprentice As String
Dim oArquivoScriptApprentice As String
Dim oArquivoLogApprentice As String

Dim oLinhasEntrada As New System.Collections.ArrayList
Dim oScriptApprentice As String

Dim oProcesso As System.Diagnostics.Process
Dim oInicioProcesso As New System.Diagnostics.ProcessStartInfo


oPastaTemporaria = System.IO.Path.GetTempPath()

oArquivoEntradaApprentice = System.IO.Path.Combine( _
    oPastaTemporaria, _
    "Renomear_IDW_Entrada_" & _
    System.Guid.NewGuid().ToString("N") & ".txt")

oArquivoScriptApprentice = System.IO.Path.Combine( _
    oPastaTemporaria, _
    "Renomear_IDW_Apprentice_" & _
    System.Guid.NewGuid().ToString("N") & ".ps1")

oArquivoLogApprentice = System.IO.Path.Combine( _
    oPastaTemporaria, _
    "Renomear_IDW_Log_" & _
    System.Guid.NewGuid().ToString("N") & ".txt")


oLinhasEntrada.Add(oArquivo)
oLinhasEntrada.Add(oNovoArquivo)
oLinhasEntrada.Add(oPastaRaiz)

For Each oArquivoIDW In oIDWsParaApprentice
    oLinhasEntrada.Add(CStr(oArquivoIDW))
Next

System.IO.File.WriteAllLines( _
    oArquivoEntradaApprentice, _
    DirectCast(oLinhasEntrada.ToArray(GetType(String)), String()), _
    New System.Text.UTF8Encoding(False))


' ============================================================
' SCRIPT POWERSHELL - APPRENTICE
' ============================================================

oScriptApprentice = _
    "$ErrorActionPreference = 'Stop'" & vbCrLf & _
    "$Entrada = $args[0]" & vbCrLf & _
    "$Log = $args[1]" & vbCrLf & _
    "function Registrar([string]$Texto) { Add-Content -LiteralPath $Log -Value $Texto -Encoding UTF8 }" & vbCrLf & _
    "$App = $null" & vbCrLf & _
    "$Total = 0; $Alterados = 0; $SemReferencia = 0; $Erros = 0; $Confirmados = 0; $Processados = 0" & vbCrLf & _
    "try {" & vbCrLf & _
    "  $Linhas = @(Get-Content -LiteralPath $Entrada -Encoding UTF8)" & vbCrLf & _
    "  $Antigo = [System.IO.Path]::GetFullPath([string]$Linhas[0])" & vbCrLf & _
    "  $Novo = [System.IO.Path]::GetFullPath([string]$Linhas[1])" & vbCrLf & _
    "  $Workspace = [System.IO.Path]::GetFullPath([string]$Linhas[2]).TrimEnd('\') + '\'" & vbCrLf & _
    "  $CLSID = [guid]'C343ED84-A129-11D3-B799-0060B0F159EF'" & vbCrLf & _
    "  $Tipo = [System.Type]::GetTypeFromCLSID($CLSID)" & vbCrLf & _
    "  $App = [System.Activator]::CreateInstance($Tipo)" & vbCrLf & _
    "  Registrar 'APPRENTICE|CRIADO'" & vbCrLf & _
    "  for ($i = 3; $i -lt $Linhas.Count; $i++) {" & vbCrLf & _
    "    $IDW = [string]$Linhas[$i]; $Doc = $null; $Achou = 0" & vbCrLf & _
    "    Registrar ('ATUAL|' + $IDW)" & vbCrLf & _
    "    try {" & vbCrLf & _
    "      $Total++" & vbCrLf & _
    "      $Doc = $App.Open($IDW)" & vbCrLf & _
    "      if (-not $Doc.IsModifiable) { throw 'O desenho não está modificável.' }" & vbCrLf & _
    "      if ($Doc.NeedsMigrating) { throw 'O desenho precisa ser migrado.' }" & vbCrLf & _
    "      $CaminhosAntigos = @()" & vbCrLf & _
    "      $DestinosEsperados = @()" & vbCrLf & _
    "      foreach ($Ref in $Doc.ReferencedFileDescriptors) {" & vbCrLf & _
    "        $CaminhoRef = [string]$Ref.FullFileName" & vbCrLf & _
    "        if (-not [string]::IsNullOrWhiteSpace($CaminhoRef) -and [System.IO.Path]::GetFileName($CaminhoRef) -ieq [System.IO.Path]::GetFileName($Antigo)) {" & vbCrLf & _
    "          $CaminhoRef = [System.IO.Path]::GetFullPath($CaminhoRef)" & vbCrLf & _
    "          if (-not $CaminhoRef.StartsWith($Workspace, [System.StringComparison]::OrdinalIgnoreCase)) { continue }" & vbCrLf & _
    "          $Destino = [System.IO.Path]::Combine([System.IO.Path]::GetDirectoryName($CaminhoRef), [System.IO.Path]::GetFileName($Novo))" & vbCrLf & _
    "          if (-not [System.IO.File]::Exists($Destino)) { throw ('Arquivo novo não encontrado ao lado da referência antiga: ' + $Destino) }" & vbCrLf & _
    "          $CaminhosAntigos += $CaminhoRef" & vbCrLf & _
    "          $DestinosEsperados += $Destino" & vbCrLf & _
    "          $Ref.PutLogicalFileNameUsingFull($Destino)" & vbCrLf & _
    "          $Achou++" & vbCrLf & _
    "        }" & vbCrLf & _
    "      }" & vbCrLf & _
    "      if ($Achou -eq 0) {" & vbCrLf & _
    "        $SemReferencia++; Registrar ('IDW|SEM_REFERENCIA|' + $IDW)" & vbCrLf & _
    "        $Doc.Close(); $Doc = $null" & vbCrLf & _
    "        $Processados++; Registrar ('PROGRESS|' + $Processados + '|' + ($Linhas.Count - 3) + '|' + $IDW)" & vbCrLf & _
    "        continue" & vbCrLf & _
    "      }" & vbCrLf & _
    "      $Save = $App.FileSaveAs" & vbCrLf & _
    "      $Save.AddFileToSave($Doc, $IDW)" & vbCrLf & _
    "      $Save.ExecuteSave()" & vbCrLf & _
    "      $Doc.Close(); $Doc = $null" & vbCrLf & _
    "      $Doc = $App.Open($IDW)" & vbCrLf & _
    "      $CaminhosConfirmados = @()" & vbCrLf & _
    "      foreach ($RefConf in $Doc.ReferencedFileDescriptors) {" & vbCrLf & _
    "        $CaminhoConf = [string]$RefConf.FullFileName" & vbCrLf & _
    "        if (-not [string]::IsNullOrWhiteSpace($CaminhoConf)) {" & vbCrLf & _
    "          $CaminhoConf = [System.IO.Path]::GetFullPath($CaminhoConf)" & vbCrLf & _
    "          $CaminhosConfirmados += $CaminhoConf" & vbCrLf & _
    "        }" & vbCrLf & _
    "      }" & vbCrLf & _
    "      $Novas = 0; $Antigas = 0" & vbCrLf & _
    "      foreach ($DestinoEsperado in $DestinosEsperados) {" & vbCrLf & _
    "        if ($CaminhosConfirmados -contains $DestinoEsperado) { $Novas++ }" & vbCrLf & _
    "      }" & vbCrLf & _
    "      foreach ($CaminhoAntigo in $CaminhosAntigos) {" & vbCrLf & _
    "        if ($CaminhosConfirmados -contains $CaminhoAntigo) { $Antigas++ }" & vbCrLf & _
    "      }" & vbCrLf & _
    "      if ($Antigas -gt 0 -or $Novas -lt $Achou) { throw ('Falha na confirmação. Novas=' + $Novas + '; antigas=' + $Antigas + '; esperadas=' + $Achou) }" & vbCrLf & _
    "      $Confirmados++; $Alterados++" & vbCrLf & _
    "      Registrar ('IDW|SALVAMENTO_CONFIRMADO|' + $IDW + '|REFERENCIAS=' + $Novas)" & vbCrLf & _
    "      $Doc.Close(); $Doc = $null" & vbCrLf & _
    "      $Processados++; Registrar ('PROGRESS|' + $Processados + '|' + ($Linhas.Count - 3) + '|' + $IDW)" & vbCrLf & _
    "    } catch {" & vbCrLf & _
    "      $Erros++; Registrar ('IDW|ERRO|' + $IDW + '|' + $_.Exception.Message)" & vbCrLf & _
    "      if ($null -ne $Doc) { try { $Doc.Close() } catch {}; $Doc = $null }" & vbCrLf & _
    "      $Processados++; Registrar ('PROGRESS|' + $Processados + '|' + ($Linhas.Count - 3) + '|' + $IDW)" & vbCrLf & _
    "    }" & vbCrLf & _
    "  }" & vbCrLf & _
    "  Registrar ('RESUMO|TOTAL|' + $Total)" & vbCrLf & _
    "  Registrar ('RESUMO|ALTERADOS|' + $Alterados)" & vbCrLf & _
    "  Registrar ('RESUMO|CONFIRMADOS|' + $Confirmados)" & vbCrLf & _
    "  Registrar ('RESUMO|SEM_REFERENCIA|' + $SemReferencia)" & vbCrLf & _
    "  Registrar ('RESUMO|ERROS|' + $Erros)" & vbCrLf & _
    "  if ($Erros -eq 0) { Registrar 'RESULTADO|SUCESSO' } else { Registrar 'RESULTADO|FALHA' }" & vbCrLf & _
    "} catch { Registrar ('FALHA_GERAL|' + $_.Exception.Message); exit 2 } finally { if ($null -ne $App) { try { [void][System.Runtime.InteropServices.Marshal]::FinalReleaseComObject($App) } catch {} } }" & vbCrLf


System.IO.File.WriteAllText( _
    oArquivoScriptApprentice, _
    oScriptApprentice, _
    New System.Text.UTF8Encoding(False))


' ============================================================
' EXECUTA O APPRENTICE
' ============================================================

oInicioProcesso.FileName = "powershell.exe"

oInicioProcesso.Arguments = _
    "-NoProfile -ExecutionPolicy Bypass -File """ & _
    oArquivoScriptApprentice & """ """ & _
    oArquivoEntradaApprentice & """ """ & _
    oArquivoLogApprentice & """"

oInicioProcesso.UseShellExecute = False
oInicioProcesso.CreateNoWindow = True
oInicioProcesso.WindowStyle = _
    System.Diagnostics.ProcessWindowStyle.Hidden

AtualizarProgressoDOMA( _
    oJanelaProgresso, 55, _
    "Iniciando o Apprentice...", _
    "Aguardando a abertura do mecanismo de processamento de desenhos.", _
    "IDWs na fila: " & oIDWsParaApprentice.Count.ToString())

oProcesso = System.Diagnostics.Process.Start(oInicioProcesso)

Dim oIndiceLinhaLog As Integer = 0
Dim oIDWsProcessados As Integer = 0
Dim oTotalIDWsProcessamento As Integer = oIDWsParaApprentice.Count

If oTotalIDWsProcessamento = 0 Then

    AtualizarProgressoDOMA( _
        oJanelaProgresso, 55, _
        "Iniciando o Apprentice...", _
        "Não há IDWs fechados na fila; aguardando a finalização da inicialização.", _
        "Arquivos processados: 0 de 0")

    While Not oProcesso.HasExited
        System.Windows.Forms.Application.DoEvents()
        System.Threading.Thread.Sleep(200)
    End While

    AtualizarProgressoDOMA( _
        oJanelaProgresso, 90, _
        "Etapa Apprentice concluída.", _
        "Não havia IDWs fechados para processamento externo.", _
        "Arquivos processados: 0 de 0")

Else

    While Not oProcesso.HasExited

        LerLogProgressoDOMA( _
            oArquivoLogApprentice, oJanelaProgresso, _
            oIndiceLinhaLog, oIDWsProcessados, oTotalIDWsProcessamento)

        System.Windows.Forms.Application.DoEvents()
        System.Threading.Thread.Sleep(200)

    End While

    ' Uma última leitura captura as linhas gravadas no encerramento do processo.
    LerLogProgressoDOMA( _
        oArquivoLogApprentice, oJanelaProgresso, _
        oIndiceLinhaLog, oIDWsProcessados, oTotalIDWsProcessamento)

End If

If System.IO.File.Exists(oArquivoLogApprentice) Then

    oResultadoApprentice = System.IO.File.ReadAllText( _
        oArquivoLogApprentice)

End If


' ============================================================
' VERIFICA RESULTADO DO APPRENTICE
' ============================================================

If oProcesso.ExitCode <> 0 OrElse _
   Not oResultadoApprentice.Contains("RESULTADO|SUCESSO") OrElse _
   Not oResultadoApprentice.Contains("RESUMO|ERROS|0") Then

    oFalhasDesenho = 1

    AtualizarProgressoDOMA( _
        oJanelaProgresso, 93, _
        "Processamento concluído com pendências.", _
        "O registro técnico contém os desenhos que precisam de verificação.", _
        "Verificação necessária")
    FecharProgressoDOMA(oJanelaProgresso)

    MensagemVisual( _
        "A renomeação do componente foi realizada, mas o processamento dos desenhos pelo Apprentice apresentou falha." & _
        vbCrLf & vbCrLf & _
        "Consulte o registro para identificar os desenhos que precisam de verificação:" & _
        vbCrLf & oArquivoLogApprentice & _
        vbCrLf & vbCrLf & _
        "O registro técnico foi mantido em arquivo.", _
        "Verificação necessária", _
        System.Windows.Forms.MessageBoxButtons.OK, _
        System.Windows.Forms.MessageBoxIcon.Warning)

End If


' ============================================================
' VERIFICA RESULTADO DOS IDWS ABERTOS
' ============================================================

If oIDWFalhasAbertos.Count > 0 Then

    AtualizarProgressoDOMA( _
        oJanelaProgresso, 93, _
        "Processamento concluído com pendências.", _
        "Um ou mais desenhos abertos precisam de conferência.", _
        "Verificação dos desenhos abertos")
    FecharProgressoDOMA(oJanelaProgresso)

    MensagemVisual( _
        "A renomeação do componente foi realizada, mas não foi possível confirmar a atualização de um ou mais desenhos que estavam abertos no Inventor." & _
        vbCrLf & vbCrLf & _
        "Desenhos que precisam de verificação:" & _
        vbCrLf & vbCrLf & _
        oListaFalhasIDWsAbertos & _
        "Os desenhos permanecem abertos e não foram salvos pela regra." & _
        vbCrLf & _
        "Verifique as referências antes de salvar manualmente.", _
        "Verificação dos desenhos abertos", _
        System.Windows.Forms.MessageBoxButtons.OK, _
        System.Windows.Forms.MessageBoxIcon.Warning)

End If


AtualizarProgressoDOMA( _
    oJanelaProgresso, 96, _
    "Conferindo resultado da renomeação...", _
    "Verificando a existência do arquivo original e do novo arquivo.", _
    "Conferência final")

' ============================================================
' LIMPEZA DOS ARQUIVOS TEMPORARIOS
' ============================================================

Try
    System.IO.File.Delete(oArquivoEntradaApprentice)
    System.IO.File.Delete(oArquivoScriptApprentice)
Catch
End Try

oIDWsAbertosPelaRegra.Clear()


' ============================================================
' CONFIRMA RESULTADO DA RENOMEACAO
' ============================================================

oOriginalExiste = System.IO.File.Exists(oArquivo)
oDestinoExiste = System.IO.File.Exists(oNovoArquivo)

If Not oOriginalExiste AndAlso oDestinoExiste AndAlso _
   oFalhasDesenho = 0 Then

    AtualizarProgressoDOMA( _
        oJanelaProgresso, 100, _
        "Renomeação concluída com sucesso.", _
        "Todas as verificações foram concluídas sem falhas.", _
        "Processamento finalizado")
    System.Windows.Forms.Application.DoEvents()
    System.Threading.Thread.Sleep(700)
    FecharProgressoDOMA(oJanelaProgresso)

    Dim janelaSucesso As System.Windows.Forms.Form

    janelaSucesso = CriarJanelaDOMA( _
        "Renomear componente", _
        "Componente renomeado com sucesso.")

    Dim botaoOK As System.Windows.Forms.Button

    botaoOK = CriarBotao("OK", 165, 125, 100)

    janelaSucesso.Controls.Add(botaoOK)

    janelaSucesso.AcceptButton = botaoOK

    AddHandler botaoOK.Click, Sub()
        janelaSucesso.Close()
    End Sub

    janelaSucesso.ShowDialog()
    janelaSucesso.Dispose()

    Return 1

Else

    AtualizarProgressoDOMA( _
        oJanelaProgresso, 95, _
        "Concluído com pendências.", _
        "A renomeação ou alguma referência precisa de verificação.", _
        "Processamento finalizado com ressalvas")
    System.Windows.Forms.Application.DoEvents()
    System.Threading.Thread.Sleep(700)
    FecharProgressoDOMA(oJanelaProgresso)

    MensagemVisual( _
        "A renomeação precisa ser verificada." & _
        vbCrLf & vbCrLf & _
        "Confira os arquivos e suas referências antes de continuar.", _
        "Renomear componente", _
        System.Windows.Forms.MessageBoxButtons.OK, _
        System.Windows.Forms.MessageBoxIcon.Warning)

    Return -1

End If

Catch ex As Exception

    Dim oIDWParaFechar As Document

    For Each oIDWParaFechar In oIDWsAbertosPelaRegra

        Try
            oIDWParaFechar.Close(True)
        Catch
        End Try

    Next

    oIDWsAbertosPelaRegra.Clear()
    FecharProgressoDOMA(oJanelaProgresso)

    MensagemVisual( _
        "Ocorreu um erro durante a renomeação:" & _
        vbCrLf & ex.Message, _
        "Renomear componente", _
        System.Windows.Forms.MessageBoxButtons.OK, _
        System.Windows.Forms.MessageBoxIcon.Error)

    Return -1

End Try

End Function
