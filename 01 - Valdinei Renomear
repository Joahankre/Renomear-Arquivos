Sub Main()

    If ThisApplication.ActiveDocument.DocumentType <> _
        DocumentTypeEnum.kAssemblyDocumentObject Then

        MensagemVisual( _
            "Abra uma montagem (IAM) antes de executar esta regra.", _
            "Renomear componente")
        Exit Sub

    End If

    Dim oMontagem As AssemblyDocument
    oMontagem = ThisApplication.ActiveDocument

    Dim oContadores(1) As Integer
    oContadores(0) = 0
    oContadores(1) = 0

    AguardarSelecao(oMontagem, oContadores)

End Sub


