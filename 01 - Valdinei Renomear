Function MensagemVisual( _
    ByVal texto As String, _
    ByVal titulo As String, _
    Optional ByVal botoes As System.Windows.Forms.MessageBoxButtons = System.Windows.Forms.MessageBoxButtons.OK, _
    Optional ByVal icone As System.Windows.Forms.MessageBoxIcon = System.Windows.Forms.MessageBoxIcon.None) _
    As System.Windows.Forms.DialogResult

    Dim f As New System.Windows.Forms.Form
    ConfigurarFormulario(f)

    f.Text = titulo
    f.ClientSize = New System.Drawing.Size(520, 200)

    Dim faixa As New System.Windows.Forms.Panel
    faixa.SetBounds(0, 0, 520, 6)
    faixa.BackColor = CorCabecalho()
    f.Controls.Add(faixa)

    Dim rotulo As New System.Windows.Forms.Label
    rotulo.Text = texto
    rotulo.SetBounds(24, 23, 472, 92)
    rotulo.ForeColor = CorTexto()
    rotulo.BackColor = CorFundo()
    rotulo.Font = New System.Drawing.Font("Segoe UI", 9.0!)
    rotulo.TextAlign = System.Drawing.ContentAlignment.MiddleLeft
    rotulo.AutoEllipsis = False
    f.Controls.Add(rotulo)

    Dim yBotoes As Integer = 130
    Dim larguraBotao As Integer = 104
    Dim espaco As Integer = 10
    Dim totalBotoes As Integer
    Dim xInicial As Integer

    If botoes = System.Windows.Forms.MessageBoxButtons.YesNo OrElse _
       botoes = System.Windows.Forms.MessageBoxButtons.YesNoCancel Then
        totalBotoes = If( _
            botoes = System.Windows.Forms.MessageBoxButtons.YesNo, 2, 3)
    ElseIf botoes = System.Windows.Forms.MessageBoxButtons.OKCancel Then
        totalBotoes = 2
    Else
        totalBotoes = 1
    End If

    xInicial = (520 - _
        (totalBotoes * larguraBotao + _
        (totalBotoes - 1) * espaco)) \ 2

    Dim b1 As System.Windows.Forms.Button
    Dim b2 As System.Windows.Forms.Button
    Dim b3 As System.Windows.Forms.Button

    If botoes = System.Windows.Forms.MessageBoxButtons.YesNo Then

        b1 = CriarBotao("Sim", xInicial, yBotoes, larguraBotao)
        b2 = CriarBotao("Não", xInicial + larguraBotao + espaco, yBotoes, larguraBotao)

        b1.DialogResult = System.Windows.Forms.DialogResult.Yes
        b2.DialogResult = System.Windows.Forms.DialogResult.No

        f.Controls.Add(b1)
        f.Controls.Add(b2)
        f.AcceptButton = b1
        f.CancelButton = b2

    ElseIf botoes = System.Windows.Forms.MessageBoxButtons.YesNoCancel Then

        b1 = CriarBotao("Sim", xInicial, yBotoes, larguraBotao)
        b2 = CriarBotao("Não", xInicial + larguraBotao + espaco, yBotoes, larguraBotao)
        b3 = CriarBotao("Cancelar", xInicial + 2 * (larguraBotao + espaco), yBotoes, larguraBotao)

        b1.DialogResult = System.Windows.Forms.DialogResult.Yes
        b2.DialogResult = System.Windows.Forms.DialogResult.No
        b3.DialogResult = System.Windows.Forms.DialogResult.Cancel

        f.Controls.Add(b1)
        f.Controls.Add(b2)
        f.Controls.Add(b3)
        f.AcceptButton = b1
        f.CancelButton = b3

    ElseIf botoes = System.Windows.Forms.MessageBoxButtons.OKCancel Then

        b1 = CriarBotao("OK", xInicial, yBotoes, larguraBotao)
        b2 = CriarBotao("Cancelar", xInicial + larguraBotao + espaco, yBotoes, larguraBotao)

        b1.DialogResult = System.Windows.Forms.DialogResult.OK
        b2.DialogResult = System.Windows.Forms.DialogResult.Cancel

        f.Controls.Add(b1)
        f.Controls.Add(b2)
        f.AcceptButton = b1
        f.CancelButton = b2

    Else

        b1 = CriarBotao("OK", xInicial, yBotoes, larguraBotao)
        b1.DialogResult = System.Windows.Forms.DialogResult.OK

        f.Controls.Add(b1)
        f.AcceptButton = b1
        f.CancelButton = b1

    End If

    AdicionarRodape(f, 173, 520)

    Dim resultado As System.Windows.Forms.DialogResult
    resultado = f.ShowDialog()

    f.Dispose()

    Return resultado

End Function


