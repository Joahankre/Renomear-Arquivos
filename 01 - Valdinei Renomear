Function CarregarLogoDOMA() As System.Drawing.Image

    Dim base64Logo As String = _
    ""

    Dim dadosLogo As Byte() = _
        System.Convert.FromBase64String(base64Logo)

    Using fluxo As New System.IO.MemoryStream(dadosLogo)

        Using imagemOriginal As System.Drawing.Image = _
            System.Drawing.Image.FromStream(fluxo)

            Return New System.Drawing.Bitmap(imagemOriginal)

        End Using

    End Using

End Function


