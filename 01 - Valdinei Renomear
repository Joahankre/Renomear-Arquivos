' ============================================================
' JANELA DE SELEÇÃO DO COMPONENTE
' IDENTIDADE VISUAL DOMA
' ============================================================

Sub AguardarSelecao( _
    ByVal oMontagem As AssemblyDocument, _
    ByVal oContadores() As Integer)

    Try
        oMontagem.SelectSet.Clear()
    Catch
    End Try

    Dim oFormulario As System.Windows.Forms.Form

    oFormulario = CriarJanelaDOMA( _
        "Renomear componente", _
        "Selecione uma peça ou submontagem na árvore." & vbCrLf & _
        "Pressione Esc quando terminar.")

    oFormulario.TopMost = True
    oFormulario.KeyPreview = True

    Dim oTemporizador As New System.Windows.Forms.Timer
    oTemporizador.Interval = 300

    Dim oSelecaoFeita As Boolean = False
    Dim oProcessando As Boolean = False

    AddHandler oFormulario.KeyDown, _
    Sub(sender As Object, E As System.Windows.Forms.KeyEventArgs)

        If E.KeyCode = System.Windows.Forms.Keys.Escape Then

            E.Handled = True

            oFormulario.TopMost = False
            oFormulario.Close()

        End If

    End Sub

    AddHandler oTemporizador.Tick, _
        Sub(sender As Object, e As System.EventArgs)

            Try
                If oMontagem.SelectSet.Count > 0 AndAlso Not oProcessando Then

                    Dim oItem As Object
                    oItem = oMontagem.SelectSet.Item(1)

                    If TypeOf oItem Is ComponentOccurrence Then

                        Dim oOcorrencia As ComponentOccurrence
                        oOcorrencia = DirectCast(oItem, ComponentOccurrence)

                        oProcessando = True
                        oSelecaoFeita = True

                        oTemporizador.Stop()
                        oFormulario.Hide()

                        Dim oResultado As Integer
                        oResultado = ProcessarRenomeacao(oMontagem, oOcorrencia)

                        If oResultado = 1 Then
                            oContadores(0) += 1
                        ElseIf oResultado = -1 Then
                            oContadores(1) += 1
                        End If

                        oFormulario.Dispose()
                        oTemporizador.Dispose()

                        AguardarSelecao(oMontagem, oContadores)

                    End If
                End If

            Catch ex As Exception

                Try
                    oTemporizador.Stop()
                    oFormulario.Close()
                    oFormulario.Dispose()
                    oTemporizador.Dispose()
                Catch
                End Try

                MensagemVisual( _
                    "Não foi possível continuar:" & vbCrLf & ex.Message, _
                    "Renomear componente")

                oContadores(1) += 1
                AguardarSelecao(oMontagem, oContadores)

            End Try
        End Sub


    AddHandler oFormulario.FormClosed, _
        Sub(sender As Object, E As System.Windows.Forms.FormClosedEventArgs)

            Try
                oTemporizador.Stop()
                oTemporizador.Dispose()
            Catch
            End Try

            If Not oSelecaoFeita Then

                oFormulario.TopMost = False

                ' JANELA FINAL DE CONCLUSÃO COM IDENTIDADE DOMA

                Dim textoConclusao As String

                textoConclusao = _
                    "Processo de renomeação encerrado." & _
                    vbCrLf & vbCrLf & _
                    "Renomeações concluídas: " & _
                    oContadores(0).ToString() & vbCrLf & _
                    "Operações com falha: " & _
                    oContadores(1).ToString() & vbCrLf & vbCrLf & _
                    "Salve os documentos quando terminar."

                Dim janelaConclusao As System.Windows.Forms.Form

janelaConclusao = CriarJanelaDOMA( _
    "Renomear componente", textoConclusao)

For Each controle As System.Windows.Forms.Control In janelaConclusao.Controls

    If TypeOf controle Is System.Windows.Forms.Panel Then

        ' ÁREA CENTRAL
        If controle.Location.Y = 32 Then

            controle.Height = 121

            For Each item As System.Windows.Forms.Control In controle.Controls

                If TypeOf item Is System.Windows.Forms.Label Then

                    item.Location = New System.Drawing.Point(10, 12)
                    item.Size = New System.Drawing.Size(410, 90)

                End If

            Next

        End If

        ' RODAPÉ DOMA
        If controle.Location.Y = 119 Then

            controle.Location = New System.Drawing.Point(10, 153)

        End If

    End If

Next

janelaConclusao.ClientSize = New System.Drawing.Size(430, 234)


janelaConclusao.KeyPreview = True

AddHandler janelaConclusao.KeyDown, Sub(objetoEvento, teclaEvento)

    If teclaEvento.KeyCode = System.Windows.Forms.Keys.Enter Then

        teclaEvento.Handled = True
        teclaEvento.SuppressKeyPress = True

        janelaConclusao.Close()

    End If

End Sub

janelaConclusao.ShowDialog()
janelaConclusao.Dispose()

            End If

        End Sub


    oFormulario.Show()
    oTemporizador.Start()

End Sub


