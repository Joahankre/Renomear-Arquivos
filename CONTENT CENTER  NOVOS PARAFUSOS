' Codigo do Consistem da peca (iProperty Centro de custos). "" = sem codigo.
' Memoria dos codigos no PC (%APPDATA%\TrocarParafusos\codigos.txt): "arquivo|data do arquivo|codigo".
' Fica no dicionario com chave "@arquivo". Assim so abre de novo a peca cujo arquivo mudou.
Function ArquivoMemoria() As String
    Return IOPath.Combine(System.Environment.GetFolderPath(System.Environment.SpecialFolder.ApplicationData),"TrocarParafusos\codigos.txt")
End Function

Sub CarregarMemoria(codigos As Dictionary(Of String, String))
    Try
        Dim m As String = ArquivoMemoria()
        If Not IOFile.Exists(m) Then Return
        For Each linha As String In IOFile.ReadAllLines(m, Encoding.UTF8)
            Dim c() As String = linha.Split("|"c)
            If c.Length = 3 Then codigos("@" & c(0)) = c(1) & "|" & c(2)
        Next
    Catch
    End Try
End Sub

Sub SalvarMemoria(codigos As Dictionary(Of String, String))
    Try
        Dim linhas As New List(Of String)
        For Each par As KeyValuePair(Of String, String) In codigos
            If par.Key.StartsWith("@") Then linhas.Add(par.Key.Substring(1) & "|" & par.Value)
        Next
        Dim m As String = ArquivoMemoria()
        IODir.CreateDirectory(IOPath.GetDirectoryName(m))
        IOFile.WriteAllLines(m, linhas.ToArray(), Encoding.UTF8)
    Catch
    End Try
End Sub

Function Codigo(arq As String, codigos As Dictionary(Of String, String)) As String
    If codigos.ContainsKey(arq) Then Return codigos(arq)
    Dim data As String = ""
    Try
        If IOFile.Exists(arq) Then data = IOFile.GetLastWriteTimeUtc(arq).Ticks.ToString()
    Catch
    End Try
    If data <> "" AndAlso codigos.ContainsKey("@" & arq) Then
        Dim v() As String = codigos("@" & arq).Split("|"c)
        If v.Length = 2 AndAlso v(0) = data Then
            codigos(arq) = v(1)
            Return v(1)
        End If
    End If
    Dim lido As Boolean = False
    Dim c As String = ""
    Dim doc As Document = Nothing
    Dim jaAberto As Boolean = False
    Try
        For Each d As Document In ThisApplication.Documents
            If String.Equals(d.FullFileName, arq, StringComparison.OrdinalIgnoreCase) Then
                doc = d
                jaAberto = True
                Exit For
            End If
        Next
        If doc Is Nothing Then doc = ThisApplication.Documents.Open(arq, False)
        c = CStr(doc.PropertySets.Item("Design Tracking Properties").Item("Cost Center").Value).Trim()
        lido = True
    Catch
        c = ""
    End Try
    Try
        If doc IsNot Nothing AndAlso Not jaAberto AndAlso doc.ReferencingDocuments.Count = 0 Then doc.Close(True)
    Catch
    End Try
    codigos(arq) = c
    If lido AndAlso data <> "" Then codigos("@" & arq) = data & "|" & c.Replace("|", "")
    Return c
End Function

' Medida do nome: "PARAFUSO SEXTAVADO INOX - M6 x 16" -> "M6X16"; "ARRUELA ... - M10" -> "M10"
Function Chave(nome As String) As String
    Dim s As String = nome.ToUpper().Replace(".IPT", "").Replace(ChrW(215), "X").Replace(" ", "")
    Dim ms As MatchCollection = Regex.Matches(s, "M(\d+(?:[.,]\d+)?)(?:X(\d+(?:[.,]\d+)?))?")
    If ms.Count = 0 Then
        ' arruela antiga "ARRUELA LISA - 10 N" = M10
        Dim mn As Match = Regex.Match(s, "-(\d+(?:[.,]\d+)?)N$")
        If mn.Success Then Return "M" & mn.Groups(1).Value.Replace(",", ".")
        Return ""
    End If
    Return ms(ms.Count - 1).Value.Replace(",", ".")
End Function
