    If r.ReadOnly Then
        fundo = System.Drawing.Color.FromArgb(255, 243, 205)
        selecao = System.Drawing.Color.FromArgb(245, 228, 175)
    ElseIf CBool(If(r.Cells("Marca").Value, False)) Then
        fundo = System.Drawing.Color.FromArgb(218, 242, 225)
        selecao = System.Drawing.Color.FromArgb(190, 228, 202)
    Else
        fundo = System.Drawing.Color.White
        selecao = System.Drawing.Color.FromArgb(228, 236, 246)
    End If
    r.DefaultCellStyle.BackColor = fundo
    r.DefaultCellStyle.SelectionBackColor = selecao
End Sub

