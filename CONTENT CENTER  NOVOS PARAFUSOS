' ===== Substituicoes: so as pecas aprovadas =====
Sub ExecutarSubstituicoes(
    topo As AssemblyDocument,
    montagens As List(Of AssemblyDocument),
    raiz As String,
    mapa As Dictionary(Of String, String),
    caminhoNovo As Dictionary(Of String, String),
    codigos As Dictionary(Of String, String),
    relatorio As List(Of String))

    Dim trocados As Integer = 0, falhas As Integer = 0
    Dim silencioso As Boolean = ThisApplication.SilentOperation
    ThisApplication.SilentOperation = True
    Dim tr As Transaction = Nothing
    Try
        tr = ThisApplication.TransactionManager.StartTransaction(topo, "Trocar parafusos antigos")
    Catch
    End Try

    Try
        Dim n As Integer = 0
        For Each asm As AssemblyDocument In montagens
            n += 1
            ThisApplication.StatusBarText = "Trocar parafusos: " & n & "/" & montagens.Count & " - " & asm.DisplayName
            Dim lista As New List(Of ComponentOccurrence)
            For Each oc As ComponentOccurrence In asm.ComponentDefinition.Occurrences
                lista.Add(oc)
            Next
            For Each oc As ComponentOccurrence In lista
                Dim antigo As String = ""
                Dim faltando As Boolean
                Try
                    faltando = oc.ReferencedDocumentDescriptor.ReferenceMissing
                    antigo = oc.ReferencedDocumentDescriptor.FullDocumentName
                Catch
                    Continue For
                End Try
                If Not antigo.ToLower().EndsWith(".ipt") Then Continue For
                If Not DentroDaBiblioteca(antigo, raiz) Then Continue For
                If Not faltando AndAlso EhNovo(Codigo(antigo, codigos)) Then Continue For

                Dim nomeAntigo As String = IOPath.GetFileNameWithoutExtension(antigo)
                Dim curto As String = IOPath.GetFileName(IOPath.GetDirectoryName(antigo)) & "\" & IOPath.GetFileName(antigo)
                If Not mapa.ContainsKey(nomeAntigo) OrElse Not caminhoNovo.ContainsKey(mapa(nomeAntigo)) Then
                    falhas += 1
                    relatorio.Add("NAO TROCOU  " & curto & "  (nao aprovada)  em " & asm.FullFileName)
                    Continue For
                End If
                Dim novo As String = caminhoNovo(mapa(nomeAntigo))

                ' 1o: troca a referencia do arquivo (funciona tambem dentro do Design Accelerator,
                '     onde o Substituir nao da erro mas nao troca). 2o: Substituir normal. Sempre confere.
                Dim erro As String = ""
                Try
                    oc.ReferencedDocumentDescriptor.ReferencedFileDescriptor.ReplaceReference(novo)
                Catch ex1 As Exception
                    erro = ex1.Message
                End Try
                If Not Trocou(oc, novo) Then
                    Try
                        oc.Replace(novo, True)
                    Catch ex2 As Exception
                        erro = ex2.Message
                    End Try
                End If
                If Not Trocou(oc, novo) Then
                    falhas += 1
                    relatorio.Add("ERRO  " & curto & "  ->  " & IOPath.GetFileName(novo) & "  (" & erro & ")  em " & asm.FullFileName)
                Else
                    trocados += 1
                    relatorio.Add("ok  " & curto & "  ->  " & IOPath.GetFileName(novo) & "  (cod " & Codigo(novo, codigos) & ")  em " & asm.FullFileName)
                End If
            Next
        Next
        If tr IsNot Nothing Then tr.End()
    Catch ex As Exception
        If tr IsNot Nothing Then tr.Abort()
        MessageBox.Show("Parou com erro: " & ex.Message, "Trocar parafusos")
    Finally
        ThisApplication.SilentOperation = silencioso
        ThisApplication.StatusBarText = ""
    End Try

    Try : topo.Update() : Catch : End Try

    ' relatorio em arquivo, ao lado da montagem
    Dim arq As String = ""
    Try
        arq = IOPath.Combine(IOPath.GetDirectoryName(topo.FullFileName), "Troca de parafusos - relatorio.txt")
        IOFile.WriteAllLines(arq, relatorio.ToArray(), Encoding.UTF8)
    Catch
        arq = ""
    End Try

    Dim msg As String = "Trocados: " & trocados & vbCrLf & "Sem trocar: " & falhas & vbCrLf & vbCrLf
    If trocados + falhas = 0 Then msg = "Nenhum parafuso para trocar." & vbCrLf & vbCrLf
    Dim mostrados As Integer = 0
    For Each l As String In relatorio
        If Not l.StartsWith("ok") AndAlso mostrados < 20 Then
            msg &= l & vbCrLf
            mostrados += 1
        End If
    Next
    If arq <> "" Then msg &= vbCrLf & "Lista completa: " & arq & vbCrLf
    msg &= vbCrLf & "Nada foi salvo. Confira e salve; se nao gostar, feche sem salvar."
    MessageBox.Show(msg, "Trocar parafusos")
End Sub

' Peca da biblioteca: dentro da pasta pt-BR (resolvida) ou caminho guardado com \pt-BR\ (faltando)
Function DentroDaBiblioteca(arq As String, raiz As String) As Boolean
    If arq.StartsWith(raiz & "\", StringComparison.OrdinalIgnoreCase) Then Return True
    Return arq.IndexOf("\pt-BR\", StringComparison.OrdinalIgnoreCase) >= 0
End Function

' Cadastro aprovado: linhas "nome antigo;nome novo" (UTF-8). Arquivo que nao existe = cadastro vazio.
Sub CarregarMapa(arquivo As String, mapa As Dictionary(Of String, String))
    Try
        If Not IOFile.Exists(arquivo) Then Return
        For Each linha As String In IOFile.ReadAllLines(arquivo, Encoding.UTF8)
            Dim c() As String = linha.Split(";"c)
            If c.Length < 2 Then Continue For
            Dim a As String = c(0).Trim().Trim(""""c).Trim(), n As String = c(1).Trim().Trim(""""c).Trim()
            If a = "" OrElse n = "" Then Continue For
            If a.ToUpper().StartsWith("ANTIG") OrElse a.ToUpper() = "NOME ANTIGO" Then Continue For
            mapa(a) = n
        Next
    Catch
    End Try
End Sub

Sub SalvarMapa(arquivo As String, mapa As Dictionary(Of String, String))
    ' junta com o que ja estava no arquivo (outra montagem pode ter aprovado outras pecas)
    Dim tudo As New Dictionary(Of String, String)(StringComparer.OrdinalIgnoreCase)
    CarregarMapa(arquivo, tudo)
    For Each par As KeyValuePair(Of String, String) In mapa
        tudo(par.Key) = par.Value
    Next
    Dim linhas As New List(Of String)
    linhas.Add("ANTIGO;NOVO")
    For Each par As KeyValuePair(Of String, String) In tudo
        linhas.Add(par.Key & ";" & par.Value)
    Next
    Try
        IOFile.WriteAllLines(arquivo, linhas.ToArray(), Encoding.UTF8)
    Catch ex As Exception
        MessageBox.Show("Nao consegui salvar o cadastro em:" & vbCrLf & arquivo & vbCrLf & ex.Message &
            vbCrLf & vbCrLf & "A troca continua, mas o cadastro nao fica guardado.", "Trocar parafusos")
    End Try
End Sub

' Indice de similaridade (0 a 1) entre o nome antigo e o novo: palavras em comum / palavras no total
' (sem acento, sem a medida, sem LIGA). Ex.: "PARAFUSO SEXTAVADO INOX - M10 x 60" x
' "PARAFUSO SEXTAVADO - DIN 933 - INOX - M10 x 60" = 3/5.
Function Similaridade(antigo As String, novo As String) As Double
    Dim a As List(Of String) = Palavras(antigo)
    Dim b As List(Of String) = Palavras(novo)
    If a.Count = 0 OrElse b.Count = 0 Then Return 0
    Dim comum As Integer = 0
    For Each w As String In a
        If b.Contains(w) Then comum += 1
    Next
    Return comum / CDbl(a.Count + b.Count - comum)
End Function

' Tipo da peca = primeira palavra do nome, sem acento (ARRUELA, PORCA, PARAFUSO, BARRA...)
Function Tipo(nome As String) As String
    Dim p As List(Of String) = Palavras(nome)
    If p.Count = 0 Then Return ""
    Return p(0)
End Function

Function Palavras(nome As String) As List(Of String)
    Dim s As String = nome.ToUpper().Replace(ChrW(215), "X").Normalize(NormalizationForm.FormD)
    ' tira a medida (M10 x 60, M10, 10 N)
    s = Regex.Replace(s, "M\s*\d+(?:[.,]\d+)?(?:\s*X\s*\d+(?:[.,]\d+)?)?", " ")
    s = Regex.Replace(s, "-\s*\d+(?:[.,]\d+)?\s*N\s*$", " ")
    Dim sb As New StringBuilder
    For Each ch As Char In s
        If Char.IsLetterOrDigit(ch) AndAlso ch < ChrW(128) Then
            sb.Append(ch)
        ElseIf ch < ChrW(128) Then
            sb.Append(" "c)
        End If
    Next
    Dim lista As New List(Of String)
    For Each w As String In sb.ToString().Split(New Char() {" "c}, StringSplitOptions.RemoveEmptyEntries)
        If w <> "LIGA" AndAlso Not lista.Contains(w) Then lista.Add(w)
    Next
    Return lista
End Function

Function Trocou(oc As ComponentOccurrence, novo As String) As Boolean
    Try
        Dim dd As DocumentDescriptor = oc.ReferencedDocumentDescriptor
        Return Not dd.ReferenceMissing AndAlso String.Equals(dd.FullDocumentName, novo, StringComparison.OrdinalIgnoreCase)
    Catch
        Return False
    End Try
End Function

' Codigo do padrao novo do Consistem: 10 digitos comecando com 103 (ex. 1030011292)
Function EhNovo(cod As String) As Boolean
    Return Regex.IsMatch(If(cod, ""), "^103\d{7}$")
End Function

